# Copy this file to .env and fill in the values:
#   cp .env.example .env
# Never commit .env — it contains passwords and secrets.

# ── Server ────────────────────────────────────────────────
# Port the API listens on (default: 3000)
PORT=3000

# Frontend URLs allowed to call the API, comma-separated
# (default: http://localhost:5173)
CORS_ORIGIN=http://localhost:5173

# ── Database (PostgreSQL) ─────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_NAME=cargo_system

# ── Authentication ────────────────────────────────────────
# Secret used to sign JWT access and refresh tokens.
# Use a long random value, e.g. the output of:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ── Email (Resend) ────────────────────────────────────────
# API key from https://resend.com/api-keys (required: the app will not start without it)
RESEND_API_KEY=

# Sender address. Leave empty to use Resend's test sender
# (onboarding@resend.dev), which can only send to your own Resend account email.
# After verifying a domain at https://resend.com/domains, set e.g.:
#   EMAIL_FROM=Cargo System <no-reply@yourdomain.com>
EMAIL_FROM=

# The website's address, used for the buttons in emails
# (default: the first CORS_ORIGIN, e.g. http://localhost:5173)
FRONTEND_URL=

# Time zone for dates and times in emails (default: Asia/Hebron)
APP_TIME_ZONE=

# ── Accounts ──────────────────────────────────────────────
# Days an unverified account is kept before it is deleted automatically.
# Default: 7
UNVERIFIED_ACCOUNT_TTL_DAYS=7

# ── Reservations ──────────────────────────────────────────
# Hours an admin has to confirm a PENDING reservation before it is
# cancelled automatically (it is also cancelled once its start date
# arrives, whichever comes first). Default: 24
PENDING_RESERVATION_TTL_HOURS=24

# ── Images (Cloudinary) ───────────────────────────────────
# From https://console.cloudinary.com → Dashboard. Needed only to upload
# or delete car images; the rest of the app works without them.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── First admin (used only by `npm run seed:admin`) ───────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_FULL_NAME=Admin
# Optional WhatsApp number with the country code, e.g. +970591234567
ADMIN_PHONE=
